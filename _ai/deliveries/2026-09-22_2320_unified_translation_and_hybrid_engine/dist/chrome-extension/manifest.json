{
  "manifest_version": 3,
  "name": "Suno 音乐通 (Suno Partner)",
  "version": "1.2.0",
  "description": "专为音乐小白与创作者打造的 Suno 全界面双行双语汉化与混合动态整句翻译伴侣，支持三星平板 S-Pen 悬浮交互。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suno.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}